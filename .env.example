# Copia este archivo a .env.local (o .env para drizzle-kit) y rellena los valores.
# Nunca subas claves reales al repo.

# H0 · Neon (proyecto crm-agents). Cadena de conexión con pooling.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Variables que llegan en hitos posteriores ---
# H4+ · LLM (capa gratuita de Gemini)
# GEMINI_API_KEY=
# H2+ · PAT de permisos finos, solo con acceso a crm-demo (D3)
# GITHUB_TOKEN=
# H2+ · Secreto para verificar la firma HMAC de los webhooks (D4)
# GITHUB_WEBHOOK_SECRET=
# H3+ · Login de demo (D10)
# AUTH_SECRET=
# DEMO_USER=
# DEMO_PASSWORD=
