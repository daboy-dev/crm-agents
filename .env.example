# Copia este archivo a .env.local (o .env para drizzle-kit) y rellena los valores.
# Nunca subas claves reales al repo.

# H0 · Neon (proyecto crm-agents). Cadena de conexión con pooling.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# H2 · Login del panel (D19). Mismos nombres que en crm-demo, valores propios.
# AUTH_SECRET firma la cookie (genera uno con `openssl rand -base64 32`).
AUTH_SECRET=
DEMO_USER=demo
DEMO_PASSWORD=

# H2 · GitHub (D3, D4, D16). PAT de permisos finos solo para crm-demo:
# Contents y Pull requests (lectura y escritura) y Actions (lectura).
GH_TOKEN=
# Secreto con el que GitHub firma los webhooks (X-Hub-Signature-256).
GH_WEBHOOK_SECRET=

# H2 · Vercel Blob privado (D18). Autenticación OIDC: VERCEL_OIDC_TOKEN llega
# con `vercel env pull` y caduca en local; no hay token estático de Blob.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# --- Variables que llegan en hitos posteriores ---
# H4+ · LLM (capa gratuita de Gemini)
# GEMINI_API_KEY=
