# Copia este archivo a .env.local (o .env para drizzle-kit) y rellena los valores.
# Nunca subas claves reales al repo.

# H0 · Neon (proyecto crm-agents). Cadena de conexión con pooling.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# H2 · Login del panel (D19). Mismos nombres que en crm-demo, valores propios.
# AUTH_SECRET firma la cookie (genera uno con `openssl rand -base64 32`).
AUTH_SECRET=
DEMO_USER=demo
DEMO_PASSWORD=

# H2 · GitHub (D3, D4, D16). PAT de permisos finos solo para crm-demo:
# Contents y Pull requests (lectura y escritura) y Actions (lectura).
GH_TOKEN=
# Secreto con el que GitHub firma los webhooks (X-Hub-Signature-256).
GH_WEBHOOK_SECRET=

# H2 · Vercel Blob privado (D18). Autenticación OIDC: VERCEL_OIDC_TOKEN llega
# con `vercel env pull` y caduca en local; no hay token estático de Blob.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# H3 · Motor de runs (D10, D23, D24). Opcionales: estos son los valores por defecto (D26).
# Runs nuevos por día (UTC) y llamadas al LLM por run antes de bloquearlo.
# RUNS_PER_DAY=5
# LLM_CALLS_PER_RUN=16

# H4 · LLM (D26). Proveedor por agente: mock o gemini (Develop y Testing, gemini desde H5/H6).
# LLM_PROVIDER=mock fuerza el mock en todos los agentes (plan B si se agota la cuota).
# LLM_PROVIDER=
LLM_PROVIDER_ORCHESTRATOR=gemini
# LLM_PROVIDER_DEVELOP=mock
# H6: gemini es la cadena de Testing (Gemini, Groq y Anthropic, D40).
# LLM_PROVIDER_TESTING=mock
# Clave de un proyecto de Google sin facturación (capa gratuita).
GEMINI_API_KEY=

# H5 · Groq, respaldo del Orquestador (D36) y, desde H6, de Testing (D40). Capa gratuita: 8.000 tokens por minuto.
GROQ_API_KEY=

# H5 · Anthropic, respaldo de pago de los tres agentes tras Gemini (D37). Conviene
# fijar un límite de gasto en la Console de Anthropic.
ANTHROPIC_API_KEY=

# H5 · Cadena de proveedor:modelo por agente (D36), en orden: al agotar la cuota diaria
# de un eslabón se pasa al siguiente, y se salta el que no puede con la petición.
# Sin clave de un proveedor, sus eslabones se saltan. Por defecto:
# LLM_CHAIN_ORCHESTRATOR=gemini:gemini-3.8-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,anthropic:claude-sonnet-5-5,groq:openai/gpt-oss-120b
# LLM_CHAIN_DEVELOP=gemini:gemini-3.8-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,anthropic:claude-sonnet-5-5
# LLM_CHAIN_TESTING=gemini:gemini-3.8-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,anthropic:claude-sonnet-5-5
