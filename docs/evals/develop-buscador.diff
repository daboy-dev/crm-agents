@@ -1,9 +1,21 @@
-import { asc, desc, eq } from "drizzle-orm";
+import { asc, desc, eq, ilike, or } from "drizzle-orm";
 import { getDb } from "@/db/client";
 import { clients, invoices, quotes } from "@/db/schema";
 
-export async function listClients() {
-  return getDb().select().from(clients).orderBy(asc(clients.name));
+export async function listClients(query?: string) {
+  const cleanQuery = query?.trim();
+  const queryFilter = cleanQuery
+    ? or(
+        ilike(clients.name, `%${cleanQuery}%`),
+        ilike(clients.email, `%${cleanQuery}%`)
+      )
+    : undefined;
+
+  return getDb()
+    .select()
+    .from(clients)
+    .where(queryFilter)
+    .orderBy(asc(clients.name));
 }
 
 /** Clients for a <select>: id and display name only. */
