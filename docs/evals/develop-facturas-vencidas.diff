+export type InvoiceDisplayStatus = InvoiceStatus | "overdue";
 
 export const quoteStatusLabels: Record<QuoteStatus, string> = {
   draft: "Borrador",
@@ -7,7 +10,19 @@ export const quoteStatusLabels: Record<QuoteStatus, string> = {
   rejected: "Rechazado",
 };
 
-export const invoiceStatusLabels: Record<InvoiceStatus, string> = {
+export const invoiceStatusLabels: Record<InvoiceDisplayStatus, string> = {
   pending: "Pendiente",
   paid: "Pagada",
+  overdue: "Vencida",
 };
+
+export function getInvoiceDisplayStatus(
+  status: InvoiceStatus,
+  dueAt: string,
+  nowIso: string = todayIso()
+): InvoiceDisplayStatus {
+  if (status === "pending" && dueAt < nowIso) {
+    return "overdue";
+  }
+  return status;
+}
